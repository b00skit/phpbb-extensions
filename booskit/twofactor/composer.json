{
    "name": "booskit/twofactor",
    "type": "phpbb-extension",
    "description": "Two-Factor Authentication (2FA) extension for phpBB with customizable group policies, sign-in flow interception, OAuth support, and backup keys",
    "homepage": "https://github.com/booskit/twofactor",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "booskit",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Booskit Two-Factor Authentication",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        }
    }
}
